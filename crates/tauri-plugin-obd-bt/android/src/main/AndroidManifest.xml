<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+ (API 31+): permissões de runtime, pedidas pelo diálogo.
         CONNECT para abrir o socket com o adaptador pareado; SCAN porque até o
         cancelDiscovery() defensivo antes de conectar exige ela (visto no carro:
         SecurityException "Need BLUETOOTH_SCAN ... cancelDiscovery()"). O
         neverForLocation dispensa a permissão de localização. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Android 11 e abaixo exigem localização para QUALQUER busca de Bluetooth,
         clássica ou BLE: sem ela a varredura volta VAZIA e sem erro nenhum, e o
         dono conclui que o adaptador está quebrado. O app já a declara para o
         `navigator.geolocation`; repetir aqui deixa o plugin inteiro por si. Só é
         pedida em runtime quando `info.sdkInt <= 30` — no Android 12+ o
         neverForLocation da BLUETOOTH_SCAN dispensa. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 11 e abaixo: instaladas junto, sem diálogo. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

</manifest>
