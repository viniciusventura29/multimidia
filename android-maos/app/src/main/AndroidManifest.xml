<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MaosApp"
        android:label="Eclipse Mãos"
        android:icon="@android:drawable/ic_menu_view"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".Principal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Só existe para pedir a permissão de print; some sozinha. -->
        <activity
            android:name=".PedirCaptura"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".Acessibilidade"
            android:exported="true"
            android:label="Eclipse Mãos"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/acessibilidade" />
        </service>

        <service
            android:name=".Notificacoes"
            android:exported="true"
            android:label="Eclipse Mãos"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".Captura"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".Instalacao"
            android:exported="false" />
    </application>
</manifest>
